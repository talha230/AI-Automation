# Copy this file to `.env` and fill in your key. `.env` is git-ignored.
#
# Secure API key management:
#   - Never commit real keys. `.env` stays local; `.env.example` is the template.
#   - In production, inject ANTHROPIC_API_KEY via your platform's secret manager
#     rather than a file on disk.
#   - The app also works with an `ant auth login` profile and no key set here.

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional overrides (defaults shown):
# MODEL=claude-opus-5
# MAX_TOKENS=8000
# EFFORT=medium
# LOG_LEVEL=INFO
# LOG_JSON=false
